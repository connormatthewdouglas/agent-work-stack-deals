{
  "identifier": "lantern-works-deals-mcp",
  "name": "Lantern Works GPU Prices & Work-Stack Deals",
  "version": "0.3.43",
  "description": "Compare tracked hourly GPU rental prices (H100, A100, RTX 4090 and more) with source links, check dates and price history, and search work-stack tool deals (compute, search, crawl, hosting, email). Public data, no auth. Some result links are referral links and are marked as such.",
  "author": "Lantern Works",
  "authorUrl": "https://github.com/connormatthewdouglas",
  "homepage": "https://github.com/connormatthewdouglas/agent-work-stack-deals",
  "cloudEndpoint": "https://lantern-works-mcp.lantern-works.workers.dev/mcp?ref=lobehub",
  "category": "developer",
  "icon": "https://thelanternworks.com/logo.png",
