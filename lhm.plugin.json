          },
          "mode": {
            "type": "string",
            "enum": [
              "brief",
              "full"
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_argument",
                  "invalid_cursor",
                  "not_found",
                  "feed_unavailable",
                  "feed_invalid",
                  "upstream_unavailable",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "vendor",
                "gpu",
                "direction"
              ]
            }
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true,
        "if": {
          "properties": {
            "ok": {
              "const": false
            }
          }
        },
        "then": {
          "required": [
            "ok",
            "error"
          ]
        },
        "else": {
          "required": [
            "ok",
            "mode",
            "total",
            "count",
            "changes"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "optimize_stack",
      "description": "Cheapest suitable stack among tracked providers for monthly needs (set the quantities you need, rest 0).\n\nscrape_pages: pages/month without JS rendering. scrape_pages_js: pages/month needing JS rendering.\nproxy_gb: residential proxy GB/month. emails_sent: transactional emails/month. search_queries: search API\nqueries/month. gpu_hours: GPU-hours/month (1 GPU), optionally gpu_model e.g. 'H100', 'A100', 'RTX 4090'.\nEach line has the chosen plan, monthly_cost_usd, calc, vendor quote, source_url, checked_at and assumptions,\nplus alternatives. A vendor price that isn't published is 'unknown' (never estimated). manual_signup_only=true\nmeans a human must sign up (never automate it); exclude_manual_signup=true drops those plans. Same data as\nhttps://thelanternworks.com/api/v1/stack-pricing.json and /tools/stack-optimizer/.",
