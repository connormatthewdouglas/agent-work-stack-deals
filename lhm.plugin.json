  "tools": [
    {
      "name": "compare_gpu_prices",
      "description": "Compare tracked GPU rental prices for one model (e.g. 'H100', 'A100 SXM', 'RTX 4090', 'L40S'), cheapest first.\n\nSame data as https://thelanternworks.com/api/v1/gpu-prices.json. Sorted by hourly_usd ascending; each result\nhas source_url and checked_at. 'Cheapest' means cheapest among tracked providers, not the whole market.\nlimit 1-25. Unknown model returns not_found listing tracked models.\nEach result has tier_class: on-demand | community | marketplace | interruptible (spot/preemptible) |\nreserved | dedicated-monthly. Reserved (reservation/commitment 'starting from') rates are left out unless\ninclude_reserved=true, and even then they are never reported as cheapest. The cheapest overall can be spot or community capacity; on_demand_only=true keeps only\non-demand rates, and the summary names the cheapest on-demand rate when the overall cheapest isn't.\ninclude_history=true adds each result's price_history (daily-snapshot change points) and history.recent_changes\n(price changes for this model among tracked providers, last 30 days) from /api/v1/gpu-prices/history.json.\nEach result has data_age_hours (hours since its price was last verified), degraded (> 48 h) and stale (> 7 days).\nmax_data_age_hours (optional) drops older rates; excluded_too_old reports how many were dropped.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gpu": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "include_history": {
            "type": "boolean",
            "default": false
          },
          "on_demand_only": {
            "type": "boolean",
            "default": false
          },
          "include_reserved": {
            "type": "boolean",
            "default": false
          },
          "max_data_age_hours": {
            "type": "number",
            "default": null
          },
          "mode": {
            "type": "string",
            "default": "full"
          }
        },
        "required": [
          "gpu"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "brief",
              "full"
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_argument",
                  "invalid_cursor",
                  "not_found",
                  "feed_unavailable",
                  "feed_invalid",
                  "upstream_unavailable",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "advertiser",
                "gpu",
                "hourly_usd",
                "source_url",
                "rank"
              ]
            }
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true,
        "if": {
          "properties": {
            "ok": {
              "const": false
            }
          }
        },
        "then": {
          "required": [
            "ok",
            "error"
          ]
        },
        "else": {
          "required": [
            "ok",
            "mode",
            "gpu",
            "summary",
            "count",
            "results"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_price_changes",
      "description": "GPU rental price changes among tracked providers, newest first, each with old/new hourly price, change_pct,\ndirection and the vendor source_url.\n\nsince: 'YYYY-MM-DD' returns every change on or after that date (daily snapshots in\n/api/v1/gpu-prices/history.json); omitted returns the latest day's moves (/api/v1/gpu-price-changes.json).\ngpu: optional model filter (substring, e.g. 'H100'). limit 1-200. Includes data_checked_at and next_refresh_utc\n(prices refresh daily at about 10:23 UTC), so you can call again after the next refresh to see what moved.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "default": null
          },
          "gpu": {
            "type": "string",
            "default": null
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "mode": {
            "type": "string",
            "default": "full"
          }
        }
      },
      "outputSchema": {
