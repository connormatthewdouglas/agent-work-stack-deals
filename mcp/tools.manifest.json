{
  "name": "lantern-works-deals",
  "title": "Lantern Works agent work-stack deals",
  "description": "Read-only discovery of affiliate-backed and public/non-affiliate work-stack deals (compute, hosting, search, crawl, unblock, email, templates) from the public Lantern Works JSON feed.",
  "version": "0.3.0",
  "auth": "none",
  "transport_hints": ["stdio", "http"],
  "feed_url": "https://thelanternworks.com/deals.json", "feed_mirror_url": "https://gist.githubusercontent.com/connormatthewdouglas/ab5c3a8dceaf396d8f0c631913433a5e/raw/deals.json",
  "human_url": "https://thelanternworks.com/lanternworks/",
  "niche": "agent-work-stack",
  "not_for": ["consumer-shopping", "entertainment", "lifestyle"],
  "filter_contract": {
    "category": "Exact deal.category",
    "affiliate": "Boolean referral vs public/non-affiliate",
    "free_tier": "affiliate==false (public free tiers). price_usd null = unknown, not free.",
    "non_affiliate": "Alias of free_tier",
    "updated_since": "ISO-8601; keep updated_at >= value; drop missing updated_at",
    "tag": "Require tag",
    "agent_only": "agent_only==true",
    "max_price_usd": "Inclusive max price_usd",
    "include_examples": "Default false (real-only)",
    "id": "Exact deal id"
  },
  "tools": [
    {
      "name": "list_deals",
      "description": "List deals from the public feed. Defaults to excluding synthetic example rows (real-only).",
      "input_schema": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "description": "compute | email | hosting | search | unblock | templates | …" },
          "tag": { "type": "string" },
          "agent_only": { "type": "boolean" },
          "affiliate": { "type": "boolean", "description": "true = affiliate; false = public/non-affiliate" },
          "free_tier": { "type": "boolean", "description": "If true, affiliate=false (public free tiers)" },
          "non_affiliate": { "type": "boolean", "description": "Alias of free_tier" },
          "updated_since": { "type": "string", "description": "ISO-8601; filter on deal.updated_at" },
          "include_examples": { "type": "boolean", "default": false },
          "max_price_usd": { "type": "number" }
        }
      }
    },
    {
      "name": "search_deals",
      "description": "Free-text search over title, tags, advertiser, and agent_instructions.",
      "input_schema": {
        "type": "object",
        "required": ["q"],
        "properties": {
          "q": { "type": "string" },
          "category": { "type": "string" },
          "affiliate": { "type": "boolean" },
          "free_tier": { "type": "boolean" },
          "updated_since": { "type": "string" },
          "include_examples": { "type": "boolean", "default": false },
          "max_price_usd": { "type": "number" }
        }
      }
    },
    {
      "name": "get_deal",
      "description": "Fetch one deal by id from the feed.",
      "input_schema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" }
        }
      }
    }
  ],
  "resources": [
    {
      "uri": "lanternworks://deals",
      "description": "Raw public deals.json"
    },
    {
      "uri": "lanternworks://human",
      "description": "Human-readable Lantern Works page"
    }
  ]
}
