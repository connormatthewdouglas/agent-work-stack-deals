# Names only. Do not put values in git.
# Verda: secrets/verda.env (cwd-relative). Lambda: secrets/lambda.env.
# wider_gpu.py reads $WGPU_SECRETS_DIR/verda.env and lambda.env when that variable is set, else secrets/.
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
LAMBDA_API_KEY=
# Environment first. If unset, the collector still reads the work-box files:
#   /workspace/secrets/hyperstack_api_key.txt
#   /workspace/secrets/novita_api_key.txt
HYPERSTACK_API_KEY=
NOVITA_API_KEY=
